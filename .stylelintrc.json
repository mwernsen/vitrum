{
  "rules": {
    "color-no-hex": true
  },
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "customSyntax": "postcss-html"
    },
    {
      "files": ["**/design/tokens/**/*.css", "**/design/styles.css"],
      "rules": {
        "color-no-hex": null
      }
    }
  ],
  "ignoreFiles": ["**/node_modules/**", "**/dist/**", "**/out/**", "**/coverage/**"]
}
